# ---- AuraStream server configuration ----
# Copy this file to .env and fill in real values.

# HTTP port the API + website runs on
PORT=4000

# Public base URL of this server (used in Paystack callbacks)
PUBLIC_URL=http://localhost:4000

# Secret used to sign login tokens (JWT). Use a long random string.
JWT_SECRET=change-this-to-a-long-random-secret-string

# How long a login session lasts
JWT_EXPIRES=7d

# ---- Paystack keys (get them from https://dashboard.paystack.com/#/settings/developers) ----
# Secret key is used server-side only. NEVER expose it to the browser.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public key is safe to expose to the browser (used by the Paystack inline popup).
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Live streaming (RTMP ingest -> HLS playback) ----
# RTMP port OBS/streaming software pushes to
RTMP_PORT=1935
# HTTP port node-media-server exposes HLS on
MEDIA_HTTP_PORT=8000

# Max upload size for videos, in megabytes
MAX_UPLOAD_MB=2048
